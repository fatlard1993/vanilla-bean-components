#!/usr/bin/env sh
# The files a push changes, one per line, from the refs git hands a pre-push hook on stdin:
#   pushed=$(sh node_modules/@vanilla-bean/components/githooks/pushed-files "$1")
# A deleted ref, or a branch at commits the remote has, changes nothing.

sh "$(dirname "$0")/pushed-log" "$1" --format= --name-only | sort -u | grep -v '^$'
